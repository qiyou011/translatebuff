# 海外线（edition=global）共享测试配置，已纳入版本控制；不得添加密钥或凭据。
# 由 node scripts/pack.mjs test --edition global 读取并注入。
# 必须覆盖 .env.production 的域名类变量，避免回落到国内生产域。

# 上游 API 基址与海外测试官网。
WXT_API_URL=https://test.translatebuff.com
WXT_WEBSITE_URL=https://test.translatebuff.com

# 官网授信 origin：Cookie 监听及 content-script 注入范围。
WXT_OFFICIAL_SITE_ORIGINS=https://test.translatebuff.com
WXT_AUTH_COOKIE_DOMAINS=translatebuff.com

# global 登录和 tokens 已分别走 AUTH_BFF / CLAW；保留此覆盖值防止混入国内生产域。
WXT_RENYIMIAO_API_URL=https://test.translatebuff.com

# 海外登录凭据须经 lrbff，不能直连 common_bll。
WXT_RENYIMIAO_AUTH_BFF_URL=https://lrbff-test-us.htjsq.com

# 海外 claw_bff（sk_key）与国内为不同实例，tokens 直接请求此地址。
WXT_RENYIMIAO_CLAW_API_URL=https://tobtest.6fast.com

# 翻译网关：海外测试网关尚未确认，按约定暂用登录后端同域占位。
# 登录前默认 / base_url 缺失时使用；此占位不代表翻译网关可用性已验证。
WXT_RENYIMIAO_GATEWAY_URL=https://cbs1sit.htjsq.com/v1

# 海外测试中台埋点域，app_start_up 与 translate_active 共用。
WXT_REPORT_API_URL=https://tobtest.6fast.com
