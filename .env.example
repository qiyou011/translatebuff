# Optional overrides for the extension's runtime URLs/domains.
# By default the extension uses production readfrog.app values.
# When WXT_USE_LOCAL_PACKAGES=true, it instead falls back to localhost values.
# Values must already be canonical:
# - URLs must not end with a trailing slash
# - origins/domains are comma-separated with no spaces
#
# WXT_API_URL=https://api.readfrog.app
# WXT_WEBSITE_URL=https://www.readfrog.app
# WXT_OFFICIAL_SITE_ORIGINS=https://readfrog.app,https://www.readfrog.app
# WXT_AUTH_COOKIE_DOMAINS=readfrog.app
#
# Fork（任译喵）后端域——登录后端 + 翻译网关（两个不同域）。真实值不入库，构建时由 env 提供：
# WXT_RENYIMIAO_API_URL=https://your-login-backend        # 平台 common_bll/claw_bff（取用户信息/密钥）
# WXT_RENYIMIAO_GATEWAY_URL=https://your-gateway/v1        # oneapi 翻译网关（登录前默认/base_url 回落）
#
# Required in poduction:
# WXT_GOOGLE_CLIENT_ID=your-google-client-id
# WXT_POSTHOG_HOST=https://us.i.posthog.com
# WXT_POSTHOG_API_KEY=phc_your_posthog_key
# WXT_ANALYTICS_DAILY_FEATURE_CACHE_ENABLED=false

# ── 发行版（edition）与正式打包 ──
# 正式包有两套配置，分别对应两条独立部署、独立后端与用户池的产品线：
#   .env.production          国内线（cn，translatebuff.cn）—— WXT 在 production 模式自动读取
#   .env.global.production   海外线（global，translatebuff.com）—— 由 scripts/pack.mjs 显式注入
# 两份都是 force-add 进仓、随仓公开，只放客户端本就能拿到的值。
#
#   node scripts/pack.mjs store --channel <id>                  国内线（不传 --edition 即 cn）
#   node scripts/pack.mjs store --edition global --channel <id> 海外线
#   node scripts/pack.mjs store --edition global --all          海外线全渠道
#
# ⚠️ 绕过 pack.mjs 直接跑 `wxt zip` 会失去双向域名护栏（本线域名必须在、另一线域名绝不能在）。
#    两线配置串味时构建照样成功、装上照样能用，直到用户登录才发现打不通——只有 pack.mjs 这条路拦得住。

# ── 海外线（edition=global）专用后端 ──────────────────────────────────────────
# 两条线的后端是不同实例，不是同一台换 path。仅 .env.global / .env.global.production 配置，
# 国内两份 env 不配（cn 直连 common_bll 即可，两者同域）。
# global 缺任一键 → 打包直接 fail-fast（scripts/assert-fork-build.mjs 的 assertEditionRequiredEnv）。
#
# 登录后端：必须走 lrbff。海外 Google 凭据由 third_party_login 签发，common_bll 只认带 BFF 换发
# SaaS Token 的上下文，扩展直连必然 401。
# WXT_RENYIMIAO_AUTH_BFF_URL=
#
# claw_bff（sk_key）：与国内不同实例，且 lrbff 无 tokens 接口，只能直连。
# WXT_RENYIMIAO_CLAW_API_URL=
